# Copy this file to .env and replace the example values.
TZ=UTC
OOKLA_EULA_ACCEPTED=true

INFLUX_URL=http://influxdb:8086
INFLUX_ORG=my-organization
INFLUX_BUCKET=speedtests
INFLUX_TOKEN=replace-with-your-influxdb-token

# Leave empty to let the Ookla CLI select a server automatically.
SPEEDTEST_SERVER_ID=
SPEEDTEST_INTERVAL=3600
HOST_TAG=home-server
